{
  "$schema": "./weapon.schema.json",
  "id": "wind-up-robot",
  "name": "Wind-up Robot",
  "description": "A clockwork toy that marches off, climbs small steps and turns back at walls; it blows on your click or after eight seconds.",
  "category": "projectile",
  "behavior": "walker",
  "targeting": "aim-angle",
  "ammo": 2,
  "crateOnly": false,
  "endsTurn": true,
  "windAffected": false,
  "damage": 45,
  "blastRadius": 40,
  "knockback": 300,
  "params": {
    "fuseSeconds": {
      "min": 8,
      "max": 8,
      "default": 8
    },
    "walkSpeed": 30,
    "gravity": 600,
    "dropSpeed": 0,
    "damageFalloff": "linear"
  }
}
