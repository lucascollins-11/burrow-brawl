{
  "$schema": "./weapon.schema.json",
  "id": "firecracker-bundle",
  "name": "Firecracker Bundle",
  "description": "Drop a fizzing bundle at your feet and run. Five seconds, then a huge bang, and any other blast that reaches it lights it early.",
  "category": "placed",
  "behavior": "dropped-charge",
  "targeting": "none",
  "ammo": 1,
  "crateOnly": false,
  "endsTurn": true,
  "windAffected": false,
  "damage": 60,
  "blastRadius": 50,
  "knockback": 380,
  "params": {
    "fuseSeconds": { "min": 5, "max": 5, "default": 5 },
    "chainFuseTicks": 30,
    "dropSpeed": 30,
    "maxBounces": 1,
    "bounciness": 0.2,
    "gravity": 600,
    "damageFalloff": "linear"
  }
}
