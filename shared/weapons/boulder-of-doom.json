{
  "$schema": "./weapon.schema.json",
  "id": "boulder-of-doom",
  "name": "Boulder of Doom",
  "description": "A huge boulder rolls slowly along your aim, grinding a tunnel through anything in its way, and blows up on the first critter it meets or after 12 s.",
  "category": "super",
  "behavior": "rolling-boulder",
  "targeting": "aim-angle",
  "ammo": 1,
  "crateOnly": true,
  "endsTurn": true,
  "windAffected": false,
  "damage": 60,
  "blastRadius": 60,
  "knockback": 500,
  "params": {
    "fuseSeconds": {
      "min": 12,
      "max": 12,
      "default": 12
    },
    "walkSpeed": 45,
    "gravity": 600,
    "dropSpeed": 0,
    "carveRadius": 20,
    "blowsOnContact": true,
    "damageFalloff": "linear"
  }
}
